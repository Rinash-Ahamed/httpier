rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This portal uses the Admin SDK after a server-side authorization check.
    // No browser/mobile SDK is allowed to read client or financial records.
    match /clients/{clientId} {
      allow read, write: if false;
      match /{document=**} { allow read, write: if false; }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
