# Firebase admin portal. All values remain server-side; do not use NEXT_PUBLIC_.
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_EMAIL=ahamedrinash@gmail.com
# Recommended: copy your Authentication user's UID to pin admin access.
FIREBASE_ADMIN_UID=

# Encrypts public invoice links. Use a different 32+ character value.
INVOICE_SIGNING_SECRET=replace-with-at-least-32-random-characters

# HTTPier payment details shown on invoices
HTTPIER_UPI_ID=upi-id
HTTPIER_PAYMENT_NAME=HTTPier
HTTPIER_PAYMENT_MOBILE=mobile-number-with-country-code

# Gmail App Password, kept server-side. Add these in Vercel, then redeploy.
SMTP_USER=ahamedrinash@gmail.com
SMTP_PASS=replace-with-your-google-app-password
CONTACT_TO_EMAIL=ahamedrinash@gmail.com
